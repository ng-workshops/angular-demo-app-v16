{
  "name": "angular-demo-app",
  "version": "1.0.0",
  "description": "Angular Demo Application to show some cool stuff :-)",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:all": "ng serve --proxy-config config/proxy.conf.json --configuration hmr & npm run start:server",
    "start:server": "node server",
    "start:client": "ng serve --proxy-config config/proxy.conf.json --configuration hmr",
    "start:dist": "ng build && DIST=true node server",
    "build": "ng build",
    "build:report": "ng build --stats-json && webpack-bundle-analyzer dist/angular-demo-app/stats.json",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:cover": "jest --silent --coverage --no-cache && open-cli coverage/lcov-report/index.html",
    "jest": "jest --silent",
    "tdd": "jest --bail --expand --verbose",
    "tdd:cover": "jest --coverage --no-cache",
    "lint": "ng lint",
    "check": "ncu",
    "ci": "npm run lint && npm run jest && npm run build"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.3.8",
    "@angular/cdk": "^17.3.8",
    "@angular/common": "^17.3.8",
    "@angular/compiler": "^17.3.8",
    "@angular/core": "^17.3.8",
    "@angular/forms": "^17.3.8",
    "@angular/material": "^17.3.8",
    "@angular/platform-browser": "^17.3.8",
    "@angular/platform-browser-dynamic": "^17.3.8",
    "@angular/router": "^17.3.8",
    "rxjs": "~7.8.1",
    "tslib": "^2.6.2",
    "zone.js": "~0.14.5"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.7",
    "@angular-eslint/builder": "17.4.0",
    "@angular-eslint/eslint-plugin": "17.4.0",
    "@angular-eslint/eslint-plugin-template": "17.4.0",
    "@angular-eslint/schematics": "17.4.0",
    "@angular-eslint/template-parser": "17.4.0",
    "@angular/cli": "~17.3.7",
    "@angular/compiler-cli": "^17.3.8",
    "@types/jasmine": "~5.1.4",
    "@types/jest": "^29.5.12",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^7.8.0",
    "body-parser": "^1.20.2",
    "compression": "^1.7.4",
    "eslint": "~8",
    "express": "^4.19.2",
    "jasmine-core": "~5.1.2",
    "jest": "^29.7.0",
    "jest-preset-angular": "^14.0.4",
    "karma": "~6.4.3",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "npm-check-updates": "^16.14.20",
    "open-cli": "^8.0.0",
    "typescript": "~5.4.5",
    "webpack-bundle-analyzer": "^4.10.2"
  },
  "packageManager": "yarn@1.22.19+sha1.4ba7fc5c6e704fce2066ecbfb0b0d8976fe62447"
}
